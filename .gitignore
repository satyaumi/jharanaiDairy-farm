# ==========================================
# Jharanai Dairy Farm Platform - Git Ignore
# ==========================================

# Environment variables & secrets (NEVER COMMIT)
.env
.env.*
!.env.example
.dev.vars
*.env
*.pem
*.key
*.p12

# Node.js & Frontend dependencies / build outputs
node_modules/
dist/
dist-ssr/
build/
.next/
.output/
.tanstack/
.wrangler/
.nitro/
.vercel/
.vinxi/

# Java & Maven artifacts
target/
*.jar
*.war
*.ear
*.class
.mvn/wrapper/maven-wrapper.jar

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Logs & monitoring traces
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage and test reports
coverage/
.nyc_output/
reports/

# IDE & Editor configuration
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
