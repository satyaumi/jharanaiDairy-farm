# ========================================================
# Backend Environment Configuration for Jharanai Farm Platform
# ========================================================

# Database Configuration (Render PostgreSQL or local)
# In Render, Render automatically populates DATABASE_URL
# e.g., DATABASE_URL=postgres://user:password@dpg-xxx.render.com/jharanai_db
DATABASE_URL=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/Dairy-farm
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Port configuration (Render dynamically assigns $PORT)
PORT=8085
SERVER_PORT=8085

# Security - JWT Token Settings (Generate a strong 256-bit+ random secret in production)
JWT_SECRET=replace_with_a_secure_production_random_secret_minimum_32_chars
JWT_EXPIRATION_MS=86400000

# CORS Configuration
# Set FRONTEND_URL to your Vercel deployment URL (e.g. https://jharanai-dairy.vercel.app)
FRONTEND_URL=https://jharanai-farm.vercel.app
CORS_ORIGINS=https://jharanai-farm.vercel.app,http://localhost:5173,http://localhost:3000

# Secure Farm Owner Initialization (Optional - updates owner password on boot)
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_EMAIL=

# Resend Email Delivery Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# In test mode without custom domain, use: Jharanai Farm <onboarding@resend.dev>
# In production with verified domain, use: Jharanai Farm <support@yourfarm.com>
RESEND_FROM_EMAIL=Jharanai Farm <onboarding@resend.dev>

